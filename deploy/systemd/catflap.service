[Unit]
Description=Catflap · 猫洞 —— 内网穿透 / 反向代理 / DDNS / 证书 控制面板
Documentation=https://github.com/chenggegedeid/catflap
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# ── 身份 ────────────────────────────────────────────────────────────────────
# ⚠️ 不要用 root。面板能读写 config/（内含 DNS Token 等明文凭据），
#    还能把内网服务暴露到公网 —— 它一旦被拿下，root 会直接放大后果。
User=catflap
Group=catflap

# ── 工作目录：这个程序的命门 ─────────────────────────────────────────────────
# 它按**工作目录**读写 config/ 与 data/。不设的话会跑到 / 底下，
# 表现为「配置保存了但重启就丢」或「启动报权限错误」。
WorkingDirectory=/opt/catflap

# 二进制放在只读位置；数据目录在 WorkingDirectory 下
ExecStart=/usr/local/bin/catflap

Restart=on-failure
RestartSec=5s

# ── 日志 ────────────────────────────────────────────────────────────────────
StandardOutput=journal
StandardError=journal
SyslogIdentifier=catflap

# ── 安全加固 ────────────────────────────────────────────────────────────────
# 思路：程序目录只读、系统只读、只放开数据目录可写。
# 副作用正好是**禁掉一键更新**（它需要原地替换自己的二进制）——
# 这是有意的：少一条远程代码执行路径。升级请用 `systemctl stop` + 手动替换 + start。

# 不允许提权（setuid / 文件能力全部失效）
NoNewPrivileges=yes

# 服务创建的文件默认 0600、目录 0700。
# 程序内部对 config/ 与 data/cert/ 已经这样设权限（见 utils/utilsFile），
# 这里是兜底：将来新增的写入点忘了设，也不会漏出一个 world-readable 的文件。
UMask=0077

# 整个文件系统只读，只有下面列出的路径可写
ProtectSystem=strict
ReadWritePaths=/opt/catflap

# /home、/root、/run/user 不可见
ProtectHome=yes
# 私有的 /tmp 与 /dev/shm
PrivateTmp=yes
PrivateDevices=yes

# 内核相关面收窄
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
# ↑ 保持 no：纯 Go 程序一般不需要 W^X，但若以后引入 CGO/插件再评估

# 只允许必要的能力（默认全部丢弃）。
# 面板监听 3791（可用环境变量 CATFLAP_PORT 改），> 1024 属非特权端口，**不需要任何 capability，也不需要 root**。
#
# 若你还想让它自己绑定 80/443（不推荐，建议前面挂 nginx/caddy），
# 必须把下面**两行都**取消注释：免 root 绑定特权端口要同时放开能力白名单
# （CapabilityBoundingSet）和 ambient 集，只放开其中一个服务会启动失败。
# CapabilityBoundingSet=CAP_NET_BIND_SERVICE
# AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete

# 网络：需要访问外网（STUN / DNS / ACME / GitHub）
# 这里不启用 PrivateNetwork，因为面板本就要被局域网访问
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

# ── 资源限制 ────────────────────────────────────────────────────────────────
LimitNOFILE=65535
# 打洞与转发会占用较多并发连接，文件描述符上限调高

[Install]
WantedBy=multi-user.target
