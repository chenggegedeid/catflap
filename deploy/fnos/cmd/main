#!/bin/bash
#
# fnOS 应用的主控脚本。飞牛会按固定协议调它：
#   cmd/main start   → 启动，成功退出 0
#   cmd/main stop    → 停止，成功退出 0
#   cmd/main status  → 运行中退出 0，未运行退出 3
#
# 两个环境变量由飞牛注入：
#   TRIM_APPDEST  应用安装目录（只读，升级时会被整包替换）
#   TRIM_PKGVAR   应用的持久目录（升级/重装都保留）——配置与数据必须落在这里
#
# 所以这里先 cd 到 TRIM_PKGVAR 再启动：Catflap 把 config/ data/ logs/
# 写在**当前工作目录**下，不 cd 就会写进只读的安装目录里，升级时全部丢失。

LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"

export PATH=$PATH:/usr/bin:/usr/sbin:/bin:/sbin

# 端口可改：在飞牛的「应用设置 → 环境变量」里加 CATFLAP_PORT 即可。
# 默认与 core.DefaultPort 保持一致（见仓库 core/listen.go）。
CMD="cd ${TRIM_PKGVAR} && ${TRIM_APPDEST}/server/catflap"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> ${LOG_FILE}
}

check_process() {
    local pid=$1
    if kill -0 "${pid}" 2>/dev/null; then
        return 0  # 进程存在
    else
        return 1
    fi
}

status() {
    if [ -f "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if check_process "${pid}"; then
            return 0
        else
            # 进程没了但 pid 文件还在，清掉，免得下次 start 以为已经在跑
            rm -f "${PID_FILE}"
        fi
    fi
    return 1
}

start_process() {
    if status; then
        return 0
    fi

    log_msg "Starting process ..."
    bash -c "${CMD}" >> ${LOG_FILE} 2>&1 &
    printf "%s" "$!" > ${PID_FILE}
    log_msg "pid = $(cat ${PID_FILE})"
    return 0
}

stop_process() {
    log_msg "Stopping process ..."

    if [ -r "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        log_msg "pid=${pid}"

        if ! check_process "${pid}"; then
            rm -f "${PID_FILE}"
            return 0
        fi

        log_msg "send TERM signal to PID:${pid} ..."
        kill -TERM "${pid}" >> ${LOG_FILE} 2>&1

        # Catflap 收到 TERM 会走 core.ListenShutdown()：保存各模块配置、
        # 停掉打洞与调度器。给它 10 秒，超时才动粗 —— 直接 KILL 会丢掉
        # 「退出时把配置写回去」这一步。
        local count=0
        while check_process "${pid}" && [ $count -lt 10 ]; do
            sleep 1
            count=$((count + 1))
            log_msg "waiting process terminal... (${count}s/10s)"
        done

        if check_process "${pid}"; then
            log_msg "send KILL signal to PID:${pid} ..."
            kill -KILL "${pid}"
            sleep 1
        else
            log_msg "process killed ..."
        fi
        rm -f "${PID_FILE}"
    fi

    return 0
}

case $1 in
start)
    start_process
    ;;
stop)
    stop_process
    ;;
status)
    if status; then
        exit 0
    else
        exit 3
    fi
    ;;
*)
    exit 1
    ;;
esac
